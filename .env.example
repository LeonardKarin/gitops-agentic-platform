# gitops-agentic-platform — environment configuration example
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ── Platform ────────────────────────────────────────────────
# Target repositories root path
PLATFORM_REPOS_ROOT=/path/to/your/repos

# Platform version (semantic versioning)
PLATFORM_VERSION=1.0.0

# ── Audit Trail ─────────────────────────────────────────────
# Path where audit logs are stored
AUDIT_LOG_PATH=./audit/logs

# Audit retention in days
AUDIT_RETENTION_DAYS=90

# ── Security ────────────────────────────────────────────────
# NVD API key (https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=your_nvd_api_key_here

# CVSS blocking threshold (default: 7.0 = High)
CVE_BLOCK_THRESHOLD=7.0

# Enable CISA KEV check (true/false)
CISA_KEV_CHECK=true

# Enable OSV check (true/false)
OSV_CHECK=true

# Enable EPSS check (true/false)
EPSS_CHECK=true

# EPSS probability threshold for blocking (0.0 to 1.0)
EPSS_BLOCK_THRESHOLD=0.7

# ── Secrets Detection ────────────────────────────────────────
# Enable secrets detection (true/false)
SECRETS_DETECTION_ENABLED=true

# Patterns file path
SECRETS_PATTERNS_FILE=./shared/security/secrets-patterns.yml

# ── Bootstrap ───────────────────────────────────────────────
# Consumer repositories list (comma-separated paths)
CONSUMER_REPOS=/path/to/repo1,/path/to/repo2

# Symlink mode (true = symlinks, false = real files)
BOOTSTRAP_SYMLINK_MODE=false

# ── Notifications ────────────────────────────────────────────
# Webhook URL for security alerts (Teams, Slack, etc.)
ALERT_WEBHOOK_URL=https://your-webhook-url-here

# Enable blocking alerts (true/false)
ALERT_ON_BLOCK=true
